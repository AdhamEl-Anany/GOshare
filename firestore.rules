rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'adham.cs.guides@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true; // Public count & stats
      allow create: if isSignedIn() && isOwner(userId);
      // Prevent non-admins from changing their own 'role' or 'plan'
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan'])
      );
      allow delete: if isAdmin();
    }

    // Files Collection
    match /files/{fileId} {
      allow read: if true; // Public file share & stats count
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId) || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // Short Links Collection
    match /links/{linkId} {
      allow read: if true; // Public share links
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // Premium Requests Collection
    match /premiumRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}

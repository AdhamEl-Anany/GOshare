{
  "name": "goshare",
  "version": "1.0.0",
  "description": "GOshare Cloud Sharing Android & Web Platform",
  "main": "index.js",
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.mkdirSync('www',{recursive:true}); ['index.html','auth.html','dashboard.html','file.html','pricing.html','admin.html','privacy.html'].forEach(f=>fs.copyFileSync(f,'www/'+f)); ['css','js','assets'].forEach(d=>fs.cpSync(d,'www/'+d,{recursive:true}));\"",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdhamEl-Anany/GOshare.git"
  },
  "keywords": [],
  "author": "ENG.Adham Hany",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
